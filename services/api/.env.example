# 后端环境变量示例
#
# 复制为 services/api/.env 后按需修改（.env 已被 .gitignore 忽略，不会入库）。
# 所有变量都以 POKEMON_LAB_ 为前缀，不设置时使用 app/core/config.py 中的默认值。

# 运行环境标识
POKEMON_LAB_ENVIRONMENT=development

# 运行期产物目录（SQLite 文件、PokéAPI 缓存）。默认 services/api/var
# POKEMON_LAB_VAR_DIR=

# 规范数据目录（属性克制表等，仓库内共享）。默认 <仓库根>/data
# POKEMON_LAB_DATA_DIR=

# 允许跨域的前端来源，JSON 数组格式
# POKEMON_LAB_CORS_ORIGINS=["http://localhost:5173"]

# PokéAPI 相关（公开接口，无需密钥）
POKEMON_LAB_POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEMON_LAB_POKEAPI_CONNECT_TIMEOUT_SECONDS=5
POKEMON_LAB_POKEAPI_READ_TIMEOUT_SECONDS=10
POKEMON_LAB_POKEAPI_MAX_RETRIES=2
# 缓存有效期（秒），默认 7 天
POKEMON_LAB_POKEAPI_CACHE_TTL_SECONDS=604800

# 图鉴立绘（pokemon.com 公开图鉴资源）同步到本地 media/artwork，离线可用
POKEMON_LAB_ARTWORK_BASE_URL=https://assets.pokemon.com/assets/cms2/img/pokedex/full
# 测试环境应设为 false，避免同步用例打真实图片网络
POKEMON_LAB_ARTWORK_SYNC_ENABLED=true
POKEMON_LAB_ARTWORK_FETCH_TIMEOUT_SECONDS=20

# 本地图片缓存目录。默认跟随 var_dir（<var_dir>/media）
# POKEMON_LAB_MEDIA_DIR=

# 双打对战辅助数据（Smogon 月度统计）
# 数据文件固定放在 <data_dir>/doubles/（仓库内），由 scripts/fetch_doubles_stats.py 生成。
# 站点运行时只读本地数据，不访问 Smogon；无需额外配置。
